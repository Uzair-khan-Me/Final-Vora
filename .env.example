# Public site URL used for canonical links, Open Graph and sitemap.
# Set this to your production domain (e.g. https://finalvora.com) when you
# deploy to Vercel. If left empty, the site falls back to the Vercel preview
# URL (VERCEL_URL) and finally to https://finalvora.com.
NEXT_PUBLIC_SITE_URL=https://finalvora.com
